# Copy to .env and fill in values. Never commit .env.
#   copy .env.example .env

# Hugging Face (faster / authenticated model downloads)
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=
# Optional mirror if huggingface.co is blocked (analysis/sentiment auto-falls back):
# HF_ENDPOINT=https://hf-mirror.com

# OpenAI (cluster summaries, optional LLM labeling)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: for Groq set OPENAI_API_KEY=gsk_... and optionally:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# Reddit PRAW (optional collectors)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=blinkit-discovery-engine/0.1 by u/yourusername

# Phase 1 embedding backend override: tfidf | st
PHASE1_EMBEDDING=tfidf

# YouTube Data API v3 (optional collector)
YOUTUBE_API_KEY=

# Groq (optional LLM polish for synthesis / insights)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Streamlit Admin page password
ADMIN_DASHBOARD_PASSWORD=blinkit-research
